{
  "name": "marp-gui",
  "version": "1.0.0",
  "private": true,
  "description": "Marp スライドを VS Code のプレビュー上で編集する環境（同期プレビュー・直接編集・配置案・ベクターPDF・プレゼン）。mac / Windows 共通。",
  "license": "Apache-2.0",
  "scripts": {
    "setup": "node tools/setup.mjs",
    "setup:check": "node tools/setup.mjs --check",
    "pdf": "node tools/marp-pdf/build-pdf.mjs",
    "pdf:safe": "node tools/marp-pdf/build-pdf.mjs --chunk 12",
    "present": "node tools/marp-present/present.mjs",
    "png": "node tools/marp-png.mjs",
    "lint": "node tools/tsutawaru-lint.mjs",
    "library": "node tools/marp-library.mjs index && node tools/marp-library.mjs thumbs && node tools/marp-library.mjs corpus",
    "corpus": "node tools/marp-library.mjs corpus",
    "test": "node --test tools/marp-scroll-sync/test/",
    "test:quick": "node --test --test-name-pattern='^(?!.*Chrome)' tools/marp-scroll-sync/test/slide-split.test.cjs tools/marp-scroll-sync/test/source-map.test.cjs tools/marp-scroll-sync/test/slide-ops.test.cjs tools/marp-scroll-sync/test/folding.test.cjs tools/marp-scroll-sync/test/library-core.test.cjs tools/marp-scroll-sync/test/corpus-core.test.cjs tools/marp-scroll-sync/test/layout-variants.test.cjs tools/marp-scroll-sync/test/home-core.test.cjs tools/marp-scroll-sync/test/wiring.test.cjs"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
