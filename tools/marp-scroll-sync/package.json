{
  "name": "marp-scroll-sync",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "marp-gui-local",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShohTagawa/marp-GUI",
    "directory": "tools/marp-scroll-sync"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:marpScrollSync.home",
    "onLanguage:markdown",
    "workspaceContains:theme/academic.css"
  ],
  "contributes": {
    "commands": [
      {
        "command": "marpScrollSync.home",
        "title": "%command.home%",
        "category": "%category%",
        "icon": "$(home)"
      },
      {
        "command": "marpScrollSync.openPreview",
        "title": "%command.openPreview%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.present",
        "title": "%command.present%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "marpScrollSync.gotoSlide",
        "title": "%command.gotoSlide%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.incFont",
        "title": "%command.incFont%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.decFont",
        "title": "%command.decFont%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.setColor",
        "title": "%command.setColor%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.clearTune",
        "title": "%command.clearTune%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.newSlide",
        "title": "%command.newSlide%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.duplicateSlide",
        "title": "%command.duplicateSlide%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.moveSlideUp",
        "title": "%command.moveSlideUp%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.moveSlideDown",
        "title": "%command.moveSlideDown%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.deleteSlide",
        "title": "%command.deleteSlide%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.markSlide",
        "title": "%command.markSlide%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.insertFromLibrary",
        "title": "%command.insertFromLibrary%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.searchSlides",
        "title": "%command.searchSlides%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.changeLayout",
        "title": "%command.changeLayout%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.rebuildCorpus",
        "title": "%command.rebuildCorpus%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.rebuildLibrary",
        "title": "%command.rebuildLibrary%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.toggleAutoFold",
        "title": "%command.toggleAutoFold%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.foldOtherSlides",
        "title": "%command.foldOtherSlides%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.unfoldAllSlides",
        "title": "%command.unfoldAllSlides%",
        "category": "%category%"
      },
      {
        "command": "marpScrollSync.writePanelLabels",
        "title": "%command.writePanelLabels%",
        "category": "%category%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marpScrollSync.present",
          "when": "activeWebviewPanelId == marpScrollSync",
          "group": "navigation@1"
        },
        {
          "command": "marpScrollSync.present",
          "when": "editorLangId == markdown && marpScrollSync.isMarp",
          "group": "navigation@1"
        },
        {
          "command": "marpScrollSync.home",
          "when": "editorLangId == markdown && marpScrollSync.isMarp",
          "group": "navigation@2"
        },
        {
          "command": "marpScrollSync.home",
          "when": "activeWebviewPanelId == marpScrollSync",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "marpScrollSync.openPreview",
        "key": "ctrl+k m",
        "mac": "cmd+k m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "marpScrollSync.incFont",
        "key": "ctrl+alt+=",
        "mac": "cmd+alt+=",
        "when": "editorTextFocus && editorLangId == markdown && marpScrollSync.isMarp"
      },
      {
        "command": "marpScrollSync.decFont",
        "key": "ctrl+alt+-",
        "mac": "cmd+alt+-",
        "when": "editorTextFocus && editorLangId == markdown && marpScrollSync.isMarp"
      },
      {
        "command": "marpScrollSync.home",
        "key": "ctrl+k h",
        "mac": "cmd+k h"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "marpScrollSync.autoFold": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoFold%"
        },
        "marpScrollSync.autoFoldKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "style",
              "svg",
              "notes"
            ]
          },
          "default": [
            "style",
            "svg"
          ],
          "description": "%config.autoFoldKinds%"
        },
        "marpScrollSync.slideLabels": {
          "type": "boolean",
          "default": true,
          "description": "%config.slideLabels%"
        },
        "marpScrollSync.panelLabels": {
          "type": "boolean",
          "default": true,
          "description": "%config.panelLabels%"
        },
        "marpScrollSync.adaptivePaste": {
          "type": "boolean",
          "default": true,
          "description": "%config.adaptivePaste%"
        },
        "marpScrollSync.saveAfterEdit": {
          "type": "boolean",
          "default": true,
          "description": "%config.saveAfterEdit%"
        },
        "marpScrollSync.home.onStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.home.onStartup%"
        },
        "marpScrollSync.home.openPreview": {
          "type": "boolean",
          "default": true,
          "description": "%config.home.openPreview%"
        }
      }
    }
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.1.0"
  }
}
