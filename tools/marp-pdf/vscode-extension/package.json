{
  "name": "marp-gui-pdf",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.4.0",
  "publisher": "marp-gui-local",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShohTagawa/marp-GUI",
    "directory": "tools/marp-pdf/vscode-extension"
  },
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:marpGui.exportPdf",
    "onCommand:marpGui.present"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtualWorkspaces%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "marpGui.present",
        "title": "%command.present%",
        "icon": "$(play)"
      },
      {
        "command": "marpGui.exportPdf",
        "title": "%command.exportPdf%",
        "icon": "$(file-pdf)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marpGui.present",
          "when": "editorLangId == markdown && marpScrollSync.isMarp",
          "group": "navigation@98"
        },
        {
          "command": "marpGui.exportPdf",
          "when": "editorLangId == markdown && marpScrollSync.isMarp",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "marpGui.chunkSize": {
          "type": "number",
          "default": 0,
          "description": "%config.chunkSize%"
        },
        "marpGui.chromePath": {
          "type": "string",
          "default": "",
          "description": "%config.chromePath%"
        },
        "marpGui.nodePath": {
          "type": "string",
          "default": "",
          "description": "%config.nodePath%"
        }
      }
    }
  }
}
